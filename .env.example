# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Бот MAX: токен из кабинета партнёра, домен стенда, секрет вебхука.
MAX_BOT_TOKEN=
BOT_DOMAIN=
WEBHOOK_SECRET=
MAX_API_BASE=https://botapi.max.ru

# Пароль Postgres задаётся один раз: том базы создаётся с ним.
POSTGRES_PASSWORD=

# Ключ шифрования паролей своих баз 1С. Не задан — берётся из токена бота.
ONEC_SECRET=

# Тестовые боты — вторая сторона сценария для проверяющих. 0 — выключить.
TEST_BOTS=1
# Слаги тестовых баз 1С через запятую: к новым витринам на них приходит
# бот-магазин. Пусто — любая тестовая база, кроме «Демо».
TEST_BOTS_BASES=
