# TLS выпускается и продлевается автоматически. MAX c 25 мая 2026 не принимает
# вебхуки по HTTP и с самоподписанными сертификатами, поэтому это обязательный узел.
{$BOT_DOMAIN} {
	encode gzip

	# Тело запроса — не больше 10 МБ: самое большое, что принимаем, — снимок
	# до 8 МБ. Без предела API читал бы гигабайтный запрос целиком, и сделать
	# это мог кто угодно: тело читается раньше, чем проверяется подпись.
	request_body {
		max_size 10MB
	}

	# Отказ по размеру — словами, как отвечает API: приложение показывает
	# поле «detail», а пустой ответ превратился бы в «Ошибка 413».
	handle_errors 413 {
		header Content-Type "application/json; charset=utf-8"
		respond `{"detail": "файл слишком большой — принимаем до 8 МБ"}` 413
	}

	# Защитные заголовки на всё, что отдаёт стенд. Запрет встраивать во
	# фрейм не ставим: веб-версия MAX открывает мини-приложение во фрейме.
	# Своя политика скриптов (CSP) есть у кабинета 1С — её ставит сам кабинет.
	header {
		# Браузер не угадывает тип: снимок из загрузки не станет страницей.
		X-Content-Type-Options nosniff
		# Только HTTPS, в том числе при ручном вводе адреса без https://.
		Strict-Transport-Security "max-age=31536000"
		# Переход по внешней ссылке не уносит адрес страницы с параметрами.
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle /webhook* {
		reverse_proxy bot:8080
	}

	handle /health {
		reverse_proxy bot:8080
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	# Кабинет тестовой базы 1С. Наружу открыт только он: сам OData-интерфейс
	# остаётся во внутренней сети, снаружи к номенклатуре хода нет.
	handle /1c* {
		reverse_proxy mock-1c:8080
	}

	# Корень домена — стартовая страница мини-приложения.
	handle {
		reverse_proxy miniapp:8080
	}
}
